rules_version = '2';

// YouPeak Firestore is accessed ONLY through the backend API, which uses the
// Firebase Admin SDK — that bypasses these rules entirely. The Flutter app has
// no cloud_firestore dependency and never talks to Firestore directly (it only
// uses firebase_auth + firebase_messaging). So every direct client request is
// denied: a signed-in user must not be able to read other users, the `admins`
// collection, revenueLedger, paymentTransactions, etc. with just their ID token.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
