# =============================================================================
# YouPeak monorepo
#   Admin_Panel/frontend   React (CRA) admin panel
#   functions/ + api/      Express backend + Vercel serverless entry
#   Youpeak_Flutter/       Flutter consumer app (mobile + web/PWA)
#   Youpeak_Landing_Page/  Vite + React landing site
#   local-dev/, worker/, tests/, scripts/, DB/
# Sub-projects keep their own .gitignore too; this file is the safety net.
# =============================================================================

# ---- Secrets & credentials (never commit) -----------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
serviceAccountKey.json
**/serviceAccountKey.json
*-firebase-adminsdk-*.json
**/google-services.json.local
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
key.properties
**/key.properties
apk-defines-production.json
**/apk-defines-production.json
!apk-defines-production.json.example
!**/apk-defines-production.json.example

