{
  "buildCommand": "npm run build --prefix admin/frontend",
  "outputDirectory": "admin/frontend/build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{functions/backend/**,DB/**,admin/frontend/DB/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/client/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|client/|static/|manifest\\.json|favicon\\.ico|logo192\\.png|logo512\\.png|robots\\.txt|asset-manifest\\.json|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
