{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix admin/frontend",
  "outputDirectory": "admin/frontend/build",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "includeFiles": "functions/backend/**"
    }
  },
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/api" },
    { "source": "/client/(.*)", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    {
      "source": "/((?!admin/|client/|api/|static/|manifest\\.json|favicon\\.ico|logo192\\.png|logo512\\.png|robots\\.txt|asset-manifest\\.json|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
