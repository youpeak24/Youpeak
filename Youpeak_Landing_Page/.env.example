# Public values for the web membership portal (sign up, log in, buy passes).
# All VITE_ variables are compiled into the browser bundle - never put a
# secret here. Set them in Vercel > Project Settings > Environment Variables.

# Backend origin (no trailing slash). Same server the Flutter app uses.
VITE_API_BASE_URL=https://api.youpeak.app

# The shared client key the app and admin panel already ship with
# (the backend's `secretKey` value). It identifies the client; it is not a
# user credential - every purchase is also authorised by the user's sign-in.
VITE_API_KEY=

# Firebase web API key (public by design). Defaults to the app's web key.
VITE_FIREBASE_API_KEY=

# Where a new Digital Partner signs in to their dashboard after buying.
VITE_ADMIN_PANEL_URL=https://admin.youpeak.app
