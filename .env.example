# ============================================================================
# YouPeak backend environment  —  copy to functions/backend/.env for local dev,
# and set each of these in the Vercel project (Settings → Environment Variables).
# NEVER commit the real .env.  Rotate any value that was ever committed.
# ============================================================================

# ── Core API auth ──────────────────────────────────────────────────────────
# Shared key the Flutter app + admin web send in the `key` header.
# Must match Constant.secretKey (app) and config.js secretKey (admin web).
secretKey=CHANGE_ME_generate_a_long_random_string

# Secret used to sign admin JWTs.
JWT_SECRET=CHANGE_ME_generate_a_different_long_random_string
ADMIN_JWT_EXPIRES_IN=7d

# Legacy user-password encryption key (Cryptr). Leave as-is until the
# bcrypt migration lands, otherwise existing email/password users lock out.
# USER_PW_SECRET=myTotallySecretKey

# ── Firebase Admin (Firestore / Auth / FCM) ────────────────────────────────
# Paste the WHOLE service-account JSON on one line (escaped), OR set
# GOOGLE_APPLICATION_CREDENTIALS to a file path instead.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"youpeak-9ff65", ... }
FIREBASE_PROJECT_ID=youpeak-9ff65
# Optional: raise if you see FIRESTORE timeouts on cold start (ms)
FIRESTORE_TIMEOUT_MS=8000
# Dev only — mirror writes to a local JSON file. Leave unset in production.
# ALLOW_LOCAL_DB_FALLBACK=false

# ── Cloudflare (video + shorts storage & streaming) ────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=youpeak-videos
CLOUDFLARE_R2_PUBLIC_DOMAIN=
# Cloudflare Stream (adaptive HLS for video + shorts)
CLOUDFLARE_STREAM_CUSTOMER_CODE=      # the "customer-xxxxx" part of playback URLs
CLOUDFLARE_STREAM_WEBHOOK_SECRET=     # Stream dashboard → Settings → Webhook
# Register the Stream webhook at: https://<domain>/api/stream/webhook

# ── Firebase Storage (non-video assets: images, thumbnails, sounds) ──
FIREBASE_STORAGE_BUCKET=youpeak-9ff65.appspot.com

# ── Payments ─────────────────────────────────────────────────────────────
# Razorpay (Dashboard → Settings → API Keys, and → Webhooks for the secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL to register at Razorpay: https://<domain>/api/payment/webhook/razorpay
#   events: payment.captured, order.paid
# Cashfree (optional alternative)
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=
# CASHFREE_ENV=PROD

# ── Scheduled maintenance (Vercel Cron) ──────────────────────────────────
# Vercel Cron calls /api/cron/daily at 00:00 IST with this as a Bearer token.
CRON_SECRET=CHANGE_ME_random_string
# CRON_BULK_RESET=false   # set true to force-reset every user's daily counters nightly

# ── One-time super-admin bootstrap ────────────────────────────────────────
# Set these once, log in to create the admin record, then DELETE them.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Misc ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production
baseURL=https://your-vercel-domain.vercel.app
# Email (Resend)
resendApiKey=
